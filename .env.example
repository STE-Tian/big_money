# Personal Quant AI v1
# Public Binance market data does not need an API key or an API secret.
# Do not put a secret in this file. .env is gitignored; this example is the only env file that belongs in git.
# The application loads only TRADING_MODE, LOG_LEVEL, and PQUANT_CONFIG_DIR from .env.
# Any other line, including BINANCE_API_KEY or BINANCE_API_SECRET, is ignored and is never logged.

TRADING_MODE=research
LOG_LEVEL=INFO
# PQUANT_CONFIG_DIR=configs
